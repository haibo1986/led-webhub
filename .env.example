# LED WebHub 环境变量示例（复制为 .env 并替换占位值）

# PostgreSQL 连接串
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/led_webhub?schema=public"

# 会话签名密钥（生产必须替换为随机强密钥，例如：openssl rand -base64 32）
SESSION_SECRET="replace-with-a-strong-random-secret"

# 无域名匹配时回退的默认公开站租户 slug
DEFAULT_TENANT_SLUG="lumenworks"

# 种子数据（生产默认拒绝执行）
DEMO_PASSWORD=""
ALLOW_SEED="false"

# 公开站 SEO 基础地址（多实例部署时建议显式配置，未配置按请求 host 推导）
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# 多实例部署时 Server Action 闭包加密密钥（所有实例必须一致）
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ---- 询盘邮件通知（SMTP，可选；未配置时邮件通知自动跳过并记 SKIPPED 日志）----
# 示例为腾讯企业邮箱；任何支持 SMTP 的企业邮箱均可
SMTP_HOST="smtp.exmail.qq.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="notify@example.com"
SMTP_PASS=""
SMTP_FROM="notify@example.com"

# ---- AI 一键翻译（DeepSeek，可选；未配置时翻译按钮隐藏，且需在平台设置开启租户 AI 开关）----
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
